# Neon PostgreSQL connection string (pooled — use for app runtime)
DATABASE_URL=

# Neon unpooled connection (use for migrations / bulk imports)
DATABASE_URL_UNPOOLED=

# Frontend read-only role password (used by setup_readonly_role.sql)
FRONTEND_READER_PASSWORD=

# Frontend (read-only connection)
VITE_NEON_URL=

# Optional: when set, the frontend dev server routes DB queries through Vite's
# /sql shim instead of Neon. Use "/sql" to target a local Postgres.
# VITE_NEON_FETCH_ENDPOINT=/sql
