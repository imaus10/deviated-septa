# Neon PostgreSQL connection string (pooled — use for app runtime)
DATABASE_URL=

# Neon unpooled connection (use for migrations / bulk imports)
DATABASE_URL_UNPOOLED=

# Frontend read-only role password (used by setup_readonly_role.sql)
FRONTEND_READER_PASSWORD=

# Frontend data source — the S3 `public/` URL the dashboard fetches
# current.json + geometries.json from (CloudFront domain, /public suffix).
# Leave empty until the endpoint is live.
VITE_PUBLIC_URL=
