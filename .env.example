# Neon PostgreSQL connection strings — TEMPORARY, used only by
# scripts/migrate_neon.py (one-off historical import). Remove when the
# migration is fully retired (after cutover; ~when 09-01 finalizes).
DATABASE_URL=

# Neon unpooled connection (bulk imports)
DATABASE_URL_UNPOOLED=

# Frontend data source — the S3 `public/` URL the dashboard fetches
# current.json + geometries.json from. Optional: defaults to the prod S3 URL
# (https://deviated-septa-prod.s3.amazonaws.com/public). Set only to override
# (e.g. point dev at the dev bucket, or the CloudFront domain once live).
VITE_PUBLIC_URL=